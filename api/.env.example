APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# Mode TLS untuk PostgreSQL. `prefer` cukup untuk server lokal; Neon
# MEWAJIBKAN `require` dan menolak koneksi tanpa TLS. Nilai ini benar-benar
# dibaca sejak FASE 0.3 (api/config/database.php); sebelumnya ditulis mati.
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# `sync`, bukan `database` (bawaan Laravel).
#
# Aplikasi ini mengirim email lewat `Mail::send()`, bukan `Mail::queue()`, jadi
# nilai ini tidak memengaruhi email hari ini - sudah dibuktikan, bukan diduga.
# Tetapi `database` berarti setiap pekerjaan yang ANTRI ditaruh di tabel `jobs`
# dan menunggu `queue:work` yang tidak pernah dijalankan: image produksi hanya
# menjalankan php-fpm, dan satu layanan Render tidak bisa menampung worker
# persisten. Pekerjaan yang masuk ke sana tidak gagal - ia diam, dan diam
# adalah kegagalan yang paling sulit ditemukan.
#
# `sync` membuat pekerjaan berjalan di dalam permintaan, yang memang perilaku
# yang dijelaskan DAT-03 di `docs/utang-teknis.md`. Jangan ubah tanpa
# menjalankan worker sungguhan.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Midtrans (T22) - pembayaran daring.
#
# Sengaja KOSONG. Tanpa kunci ini aplikasi tetap berjalan penuh: penghuni
# membayar lewat transfer/QRIS seperti biasa, dan tombol "Bayar daring"
# menjawab 503 dengan pesan yang terbaca. Yang tidak bisa dilakukan hanyalah
# membuat transaksi baru.
#
# `MIDTRANS_IS_PRODUCTION=false` memakai sandbox. Nilai ini menentukan DUA hal
# sekaligus - alamat API dan kunci mana yang dipakai - jadi mengubahnya tanpa
# mengganti kuncinya akan membuat semua notifikasi ditolak.
#
# Kunci sandbox diambil dari dashboard Midtrans -> Settings -> Access Keys.
# ---------------------------------------------------------------------------
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_KEDALUWARSA_MENIT=60

VITE_APP_NAME="${APP_NAME}"
