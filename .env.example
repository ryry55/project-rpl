# ---------------------------------------------------------------------------
# Konfigurasi demo. Disalin ke `.env` oleh `docker compose` bila belum ada.
# Jangan pakai nilai ini di produksi sungguhan.
# ---------------------------------------------------------------------------

DB_DATABASE=kos
DB_USERNAME=kos
DB_PASSWORD=kos

# Port di host. 8081 = API langsung, 3000 = aplikasi (SPA + proxy /api).
# 8080 sengaja dihindari: sering sudah dipakai proses lain di laptop pengembang.
API_PORT=8081
WEB_PORT=3000

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8081

# Mengaktifkan header X-Simulasi-Tanggal untuk mendemokan denda pada hari ke-37
# tanpa menunggu 37 hari. Wajib false di produksi.
APP_DEMO_MODE=true
