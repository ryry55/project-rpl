# --- Dependensi & artefak build -------------------------------------------
node_modules/
vendor/
dist/
build/
web/dist/
public/build/
public/hot
*.log
npm-debug.log*

# --- Environment & rahasia ------------------------------------------------
.env
.env.*
!.env.example

# --- Laravel --------------------------------------------------------------
api/storage/*.key
api/storage/framework/cache/*
api/storage/framework/sessions/*
api/storage/framework/views/*
api/storage/logs/*
api/bootstrap/cache/*
!api/storage/framework/cache/.gitignore
!api/storage/framework/sessions/.gitignore
!api/storage/framework/views/.gitignore
!api/storage/logs/.gitignore
!api/bootstrap/cache/.gitignore

# SQLite tidak dipakai, tapi jaga-jaga
*.sqlite
*.sqlite3

# --- Berkas sementara -----------------------------------------------------
*.tmp
~$*
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/

# Berkas Office sementara yang dibuat Word/Excel saat membuka dokumen
*.docx~
*.xlsx~

# --- Scratch lokal (issue tracker ada di GitHub, bukan di sini) -----------
.scratch/

# --- Catatan audit mentah ------------------------------------------------
# `revisi.md` adalah MASUKAN audit, bukan dokumen hasil. Ia ditulis pemeriksa
# luar dan dibaca sebagai daftar temuan; menyimpannya di riwayat membuat
# pemeriksa berikutnya mengira temuannya sudah dibaca padahal belum. Bentuknya
# juga berubah tiap putaran audit, sehingga setiap commit akan membawa diff
# yang tidak ada hubungannya dengan pekerjaan yang sedang dikerjakan.
revisi.md
docs/revisi.md

# --- Materi kuliah & template jurusan ------------------------------------
# Referensi pribadi, bukan bagian deliverable.
Slide Materi/
Template Laporan/

# Rakitan dokumen lama (charter kasus Smart Campus Asset) — sudah digantikan
docs/rakitan/

# Berkas pesan commit dan berkas periksa sementara. Ditulis ke disk karena
# `git commit -m` memotong pesan panjang di PowerShell, lalu dihapus setelah
# dipakai. Pola, bukan satu nama berkas: berkasnya dibuat per tiket.
# Sengaja tidak memakai `docs/uji/_*` — awalan garis bawah juga dipakai untuk
# berkas bersama seperti `_cdp.mjs`, dan pola seluas itu akan menyembunyikannya.
docs/uji/pesan-*.txt
docs/uji/komentar-*.md
docs/uji/_cek.*
docs/uji/_open.json

# Keluaran sementara pengukur halaman dan pengekspor PDF. Dibangkitkan ulang
# tiap kali dijalankan, jadi tidak boleh masuk riwayat.
docs/akademik/_ukur/
docs/akademik/_*.html

# Tangkapan layar kerja saat menilai redesign. Bukan bukti uji: bukti yang
# di-track ada di `docs/uji/*.png` dan ditulis ulang oleh skrip E2E sendiri.
# Berkas di sini hanya untuk dibaca mata selama satu sesi.
.impeccable/review/

# Ruang kerja skill desain (prototipe arah, perkakas tangkap layar, log gerbang).
# Prototipe adalah kertas kerja, bukan kode produksi: arah yang disetujui sudah
# tinggal di `web/src/style.css` dan dijelaskan di `DESIGN.md`.
.taste-skill/
